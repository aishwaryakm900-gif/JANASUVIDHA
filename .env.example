# JANASUVIDHA Environment Configuration
# ========================================================
# For local development, copy this file to .env.local and adjust values.
# The application automatically runs in DEMO_MODE when live API keys are not supplied.

# 1. DATABASE CONFIGURATION
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/janasuvidha?schema=public"

# 2. GOOGLE GEMINI API CONFIGURATION (SERVER-SIDE ONLY)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. AI & NLP MODEL CONFIGURATION
AI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

# 4. SPEECH-TO-TEXT AND VOICE CONFIGURATION
# Supports Google Cloud Speech, Whisper, Bhashini (India AI), or Web Speech API fallback
SPEECH_API_KEY=""
SPEECH_API_BASE_URL="https://api.bhashini.gov.in/v1"
SPEECH_PROVIDER="bhashini"
TTS_API_KEY=""
TTS_API_BASE_URL="https://api.bhashini.gov.in/v1"

# 5. OTP AND SMS SERVICE (TWILIO & DEMO)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_PROVIDER=mock # "mock" for demo mode, "twilio" for live SMS

SMS_API_KEY=""
SMS_API_SECRET=""
SMS_SENDER_ID="JANASV"
SMS_PROVIDER="fast2sms"
OTP_EXPIRY_SECONDS="300"

# 6. AUTHENTICATION & SECRETS
AUTH_SECRET="your-32-char-random-secret-key-goes-here-12345678"
NEXTAUTH_SECRET="your-32-char-random-secret-key-goes-here-12345678"

# 7. OBJECT STORAGE (EVIDENCE PHOTOS)
STORAGE_PROVIDER="local"
STORAGE_ACCESS_KEY="mock-access-key"
STORAGE_SECRET_KEY="mock-secret-key"
STORAGE_BUCKET="janasuvidha-evidence"
STORAGE_ENDPOINT=""

# 8. APPLICATION ENVIRONMENT
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
NEXT_PUBLIC_DEMO_MODE="true"
